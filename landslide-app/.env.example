# =====================================================================
# BhuRakshak / PahaarPulse — Landslide Mobile App Environment Template
# =====================================================================
# NOTICE: This file is a non-secret configuration template.
# Copy this file to '.env' in landslide-app/ when building for device testing.
# Never commit real credentials, API keys, or '.env' files to Git.
#
# CRITICAL CLIENT-SIDE INVARIANT:
# All EXPO_PUBLIC_* variables are compiled directly into the mobile binary JavaScript bundle.
# NEVER place database credentials, Backboard API keys, session signing secrets, or
# coordinator keys into this file or any mobile source files.
# =====================================================================

# ── Public Backend API Endpoint ──
# Consumed by apiConfig.ts and assistantApi.ts.
# Development: Optional. Automatically detects Android emulator (http://10.0.2.2:8000)
#              and physical LAN devices (http://192.168.0.102:8000).
# Production:  MANDATORY for release builds (__DEV__ === false).
#              Must be a valid, public HTTPS endpoint, e.g. https://api.example.invalid
EXPO_PUBLIC_API_URL=https://api.example.invalid
