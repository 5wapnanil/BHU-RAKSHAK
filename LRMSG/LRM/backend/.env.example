# =====================================================================
# BhuRakshak / PahaarPulse — Backend Environment Template
# =====================================================================
# NOTICE: This file is a non-secret configuration template.
# Copy this file to '.env' in backend/ and provide actual environment secrets.
# Never commit real credentials, API keys, or '.env' files to Git.
#
# VARIABLE SCOPE MATRIX:
# - PUBLIC: None (all variables here are strictly server-side backend-only)
# - SECRET: DATABASE_URL, COORDINATOR_API_KEY, BACKBOARD_API_KEY, SESSION_SIGNING_KEY, TWOFACTOR_API_KEY
# =====================================================================

# ── Application Environment & Security Mode ──
# Values: development | production | test
# In production, the backend enforces:
# 1. Fail-closed COORDINATOR_API_KEY verification (>= 16 chars).
# 2. Fail-closed SESSION_SIGNING_KEY verification (>= 32 chars).
# 3. Fail-closed TRUSTED_ORIGINS verification (must be explicit HTTPS domains).
# 4. Secure cookie attributes (Secure, HttpOnly, SameSite=Lax).
ENVIRONMENT=development

# ── PostgreSQL Database Connection ──
# Local dev: use localhost:5432
# Docker Compose: use service name 'db' as host (e.g. postgresql://lrm:CHANGE_ME@db:5432/lrm_db)
DATABASE_URL=postgresql://lrm:CHANGE_ME_DB_PASSWORD@localhost:5432/lrm_db
DATABASE_URL_SYNC=postgresql://lrm:CHANGE_ME_DB_PASSWORD@localhost:5432/lrm_db
DB_ECHO=false

# ── Docker Compose Database Settings (Used by docker-compose.yml / docker-compose.prod.yml) ──
DB_PORT=5432
DB_NAME=lrm_db
DB_USER=lrm
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Administrative & Coordinator Security ──
# Required in production. Minimum 16 characters (recommend 32-byte hex token).
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
COORDINATOR_API_KEY=CHANGE_ME_IN_DEPLOYMENT_SECRET_STORE_32CHARS_MIN

# ── CORS & Trusted Origin Validation ──
# Comma-separated list of allowed browser origins for credentialed assistant cookies.
# Development defaults: http://localhost:3000, http://127.0.0.1:3000
# Production requirement: MUST be explicit HTTPS domain(s), e.g. https://app.example.invalid
TRUSTED_ORIGINS=https://app.example.invalid

# ── Reverse Proxy / Load Balancer IP Resolution ──
# Comma-separated list of trusted upstream proxy IPs (e.g. Nginx, Cloudflare, ALB).
# Direct peer IP is verified before inspecting X-Forwarded-For headers to prevent spoofing.
TRUSTED_PROXIES=

# ── Backboard AI RAG Knowledge Assistant ──
# Provider credentials remain exclusively on the backend; never exposed to web or mobile clients.
BACKBOARD_API_KEY=CHANGE_ME_BACKBOARD_API_KEY
BACKBOARD_ASSISTANT_ID=CHANGE_ME_BACKBOARD_ASSISTANT_ID
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_TIMEOUT_SECONDS=60.0
# Provider selection: 'live' for real upstream Backboard calls, 'mock' for local offline testing
BACKBOARD_PROVIDER=mock

# ── Assistant Session Signing (HMAC-SHA256) ──
# Server-side signing secret for thread session tokens.
# Required in production; must be at least 32 characters long.
SESSION_SIGNING_KEY=CHANGE_ME_IN_DEPLOYMENT_SECRET_STORE_32CHARS_MIN
SESSION_EXPIRY_HOURS=24

# ── Field Photograph Storage ──
# Optional directory path for uploaded field report images.
# Defaults to backend/uploads/field_reports
FIELD_REPORT_UPLOAD_DIR=

# ── Cellular SMS Emergency Alerting (Optional) ──
TWOFACTOR_API_KEY=CHANGE_ME_2FACTOR_KEY
TWOFACTOR_SENDER_ID=
SMS_ENABLED=false
SMS_PROVIDER=2factor
