# ── SMS Configuration ──
TWOFACTOR_API_KEY=your_2factor_api_key_here
TWOFACTOR_SENDER_ID=
SMS_ENABLED=false
SMS_PROVIDER=2factor

# ── PostgreSQL Database ──
# For Docker Compose: use service name "db" as host
# For local PostgreSQL: use "localhost"
DATABASE_URL=postgresql://lrm:lrm_password@localhost:5432/lrm_db
DATABASE_URL_SYNC=postgresql://lrm:lrm_password@localhost:5432/lrm_db
DB_ECHO=false

# ── Docker Compose (used by docker-compose.yml) ──
DB_PORT=5432
DB_NAME=lrm_db
DB_USER=lrm
DB_PASSWORD=lrm_password

# ── Backboard AI RAG Knowledge Assistant ──
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_ASSISTANT_ID=your_backboard_assistant_id_here
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_TIMEOUT_SECONDS=30.0
BACKBOARD_PROVIDER=mock
SESSION_SIGNING_KEY=your_32_byte_secret_key_here
SESSION_EXPIRY_HOURS=24
