# =====================================================================
# BhuRakshak / PahaarPulse — Web Frontend Environment Template
# =====================================================================
# NOTICE: This file is a non-secret configuration template.
# Copy this file to '.env.local' in frontend/ for local web development.
# Never commit real credentials, API keys, or '.env.local' files to Git.
#
# VARIABLE SCOPE:
# - PUBLIC (Bundled into browser client): NEXT_PUBLIC_*
# - SERVER-ONLY (Next.js server-side / SSR API routes): BACKEND_INTERNAL_URL, COORDINATOR_API_KEY
# =====================================================================

# ── Public Backend API Base URL ──
# Consumed by browser fetch calls and assistant client module.
# Local dev: http://localhost:8000 (auto-falls back if unset)
# Production: MUST be configured with an explicit HTTPS endpoint, e.g. https://api.example.invalid
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Internal Backend API Base URL (SSR / Docker Container Network) ──
# Server-only. Used by Next.js App Router API routes to communicate directly with
# FastAPI on an internal Docker bridge network without routing through the public internet.
BACKEND_INTERNAL_URL=http://backend:8000

# ── Mock Data Flag ──
# Set to 'true' to render offline demo mock alerts/shelters, or 'false' for live backend API data.
NEXT_PUBLIC_USE_MOCK_DATA=false

# ── Coordinator Authentication Key (Server-Side Proxying Only) ──
# Server-only secret used by Next.js API route handlers to sign administrative review mutations.
# NEVER prefix with NEXT_PUBLIC_ (must not be bundled into client JavaScript).
COORDINATOR_API_KEY=CHANGE_ME_IN_DEPLOYMENT_SECRET_STORE_32CHARS_MIN
